      "raw_url": "https://raw.githubusercontent.com/danielwanyan/Bob_ProductID_newissue/main/juror_system_prompt_v4.1.txt",
      "description": "Juror System Prompt with PBR rule citation requirement and {{body}} placeholder for rules"
