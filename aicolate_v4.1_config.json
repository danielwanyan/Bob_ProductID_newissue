  "type_thresholds": {
    "child_sexualization": 0.30,
    "uncomfortable": 0.40,
    "low_quality": 0.35,
    "vulgar": 0.45,
    "ansa": 0.45,
    "politically_sensitive": 0.50,
    "prohibited": 0.50,
    "ipr": 0.50,
    "sensitive_word": 0.50,
    "crude": 0.50,
    "no_package": 0.50,
    "novelty": 0.50,
    "black_white_edge": 0.50,
    "video_screenshot": 0.50,
    "watermark": 0.50,
    "lgbt_related": 0.50,
    "other": 0.50
