  "workflow_config": {
    "nodes": {
      "start": {
        "type": "start",
        "inputs": [
          {"name": "product_id1", "type": "string"},
          {"name": "product_id2", "type": "string"},
          {"name": "product_id3", "type": "string"},
          {"name": "product_country1", "type": "string"},
          {"name": "product_country2", "type": "string"},
          {"name": "product_country3", "type": "string"},
          {"name": "product_image1", "type": "image"},
          {"name": "product_image2", "type": "image"},
          {"name": "product_image3", "type": "image"}
        ]
      },
      "rules_fetch": {
        "type": "http",
        "url": "https://raw.githubusercontent.com/danielwanyan/Bob_ProductID_newissue/main/judgment_criteria.md",
        "method": "GET",
        "outputs": [{"name": "rules_text", "type": "string"}]
      },
      "juror_a": {
        "type": "llm",
        "model": "GPT-5.4",
        "temperature": 0,
        "max_tokens": 2000,
        "timeout": 120,
        "retry": 2,
        "weight": 0.35,
        "system_prompt_url": "https://raw.githubusercontent.com/danielwanyan/Bob_ProductID_newissue/main/juror_system_prompt_v4.1.txt",
        "user_prompt_url": "https://raw.githubusercontent.com/danielwanyan/Bob_ProductID_newissue/main/juror_user_prompt_v4.1.txt",
        "rules_url": "https://raw.githubusercontent.com/danielwanyan/Bob_ProductID_newissue/main/judgment_criteria.md",
        "inputs": [
          {"name": "Product_id1", "source": "start"},
          {"name": "Product_id2", "source": "start"},
          {"name": "Product_id3", "source": "start"},
          {"name": "Product_country1", "source": "start"},
          {"name": "Product_country2", "source": "start"},
          {"name": "Product_country3", "source": "start"},
          {"name": "Product_image1", "source": "start"},
          {"name": "Product_image2", "source": "start"},
          {"name": "Product_image3", "source": "start"},
          {"name": "body", "source": "rules_fetch.rules_text"}
        ]
      },
      "juror_b": {
        "type": "llm",
        "model": "GPT-5.1",
        "temperature": 0,
        "max_tokens": 2000,
        "timeout": 120,
        "retry": 2,
        "weight": 0.40,
        "parallel_with": ["juror_a", "juror_c"],
        "system_prompt_url": "https://raw.githubusercontent.com/danielwanyan/Bob_ProductID_newissue/main/juror_system_prompt_v4.1.txt",
        "user_prompt_url": "https://raw.githubusercontent.com/danielwanyan/Bob_ProductID_newissue/main/juror_user_prompt_v4.1.txt",
        "rules_url": "https://raw.githubusercontent.com/danielwanyan/Bob_ProductID_newissue/main/judgment_criteria.md",
        "inputs": [
          {"name": "Product_id1", "source": "start"},
          {"name": "Product_id2", "source": "start"},
          {"name": "Product_id3", "source": "start"},
          {"name": "Product_country1", "source": "start"},
          {"name": "Product_country2", "source": "start"},
          {"name": "Product_country3", "source": "start"},
          {"name": "Product_image1", "source": "start"},
          {"name": "Product_image2", "source": "start"},
          {"name": "Product_image3", "source": "start"},
          {"name": "body", "source": "rules_fetch.rules_text"}
        ]
      },
      "juror_c": {
        "type": "llm",
        "model": "Gemini-2.5-Pro",
        "temperature": 0,
        "max_tokens": 2000,
        "timeout": 120,
        "retry": 2,
        "weight": 0.25,
        "parallel_with": ["juror_a", "juror_b"],
        "system_prompt_url": "https://raw.githubusercontent.com/danielwanyan/Bob_ProductID_newissue/main/juror_system_prompt_v4.1.txt",
        "user_prompt_url": "https://raw.githubusercontent.com/danielwanyan/Bob_ProductID_newissue/main/juror_user_prompt_v4.1.txt",
        "rules_url": "https://raw.githubusercontent.com/danielwanyan/Bob_ProductID_newissue/main/judgment_criteria.md",
        "inputs": [
          {"name": "Product_id1", "source": "start"},
          {"name": "Product_id2", "source": "start"},
          {"name": "Product_id3", "source": "start"},
          {"name": "Product_country1", "source": "start"},
          {"name": "Product_country2", "source": "start"},
          {"name": "Product_country3", "source": "start"},
          {"name": "Product_image1", "source": "start"},
          {"name": "Product_image2", "source": "start"},
          {"name": "Product_image3", "source": "start"},
          {"name": "body", "source": "rules_fetch.rules_text"}
        ]
      },
      "judge": {
        "type": "llm",
        "model": "GPT-5.1",
        "temperature": 0,
        "max_tokens": 3000,
        "timeout": 120,
        "retry": 2,
        "system_prompt_url": "https://raw.githubusercontent.com/danielwanyan/Bob_ProductID_newissue/main/judge_system_prompt_v4.1.txt",
        "user_prompt_url": "https://raw.githubusercontent.com/danielwanyan/Bob_ProductID_newissue/main/judge_user_prompt_v4.1.txt",
        "voting_rule": "weighted_majority_with_type_threshold",
        "inputs": [
          {"name": "LLM_Juror1", "source": "juror_c"},
          {"name": "LLM_Juror2", "source": "juror_a"},
          {"name": "LLM_Juror3", "source": "juror_b"}
        ],
        "outputs": [
          {"name": "final_verdict", "type": "string"},
          {"name": "analysis", "type": "array"},
          {"name": "most_anomalous_product_id", "type": "string"}
        ]
      },
      "end": {
        "type": "end",
        "export_fields": [
          "product_id1",
          "product_id2",
          "product_id3",
          "product_country1",
          "product_country2",
          "product_country3",
          "final_verdict",
          "analysis",
          "most_anomalous_product_id"
        ]
      }
    },
    "connections": [
      {"from": "start", "to": "rules_fetch"},
      {"from": "rules_fetch", "to": ["juror_a", "juror_b", "juror_c"]},
      {"from": "juror_a", "to": "judge"},
      {"from": "juror_b", "to": "judge"},
      {"from": "juror_c", "to": "judge"},
      {"from": "judge", "to": "end"}
    ]
