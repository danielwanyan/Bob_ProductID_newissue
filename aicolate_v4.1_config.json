  "type_priority": {
    "1": ["child_sexualization"],
    "2": ["ansa", "politically_sensitive"],
    "3": ["prohibited", "ipr", "vulgar"],
    "4": ["low_quality", "uncomfortable", "novelty"],
    "5": ["black_white_edge", "video_screenshot", "watermark"],
    "6": ["new_issue_supplement", "other"]
