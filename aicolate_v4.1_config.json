    "juror_user_prompt": {
      "path": "juror_user_prompt_v4.1.txt",
      "raw_url": "https://raw.githubusercontent.com/danielwanyan/Bob_ProductID_newissue/main/juror_user_prompt_v4.1.txt",
      "description": "Juror User Prompt for 3-product batch review with PBR citation requirement"
